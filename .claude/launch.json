{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "phone-farm-control",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "start"
      ],
      "port": 4173,
      "cwd": "system"
    },
    {
      "name": "phone-farm-demo",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "demo"
      ],
      "port": 4173,
      "cwd": "system"
    },
    {
      "name": "phone-farm-demo-broken",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "demo",
        "--",
        "--broken-phones"
      ],
      "port": 4173,
      "cwd": "system"
    },
    {
      "name": "phone-farm-demo-paused",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "demo",
        "--",
        "--paused-setup"
      ],
      "port": 4173,
      "cwd": "system"
    }
  ]
}
