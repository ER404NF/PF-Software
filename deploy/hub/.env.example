# Copy to .env and fill in. Never commit the real .env.

# The public name operators and sites will use, e.g. phones.example.com.
# Point its DNS A/AAAA record at this server before starting.
PUBLIC_HOSTNAME=

# At least 32 random characters. Generate one with:  openssl rand -hex 32
SESSION_SECRET=

# Time zone used to read /time <start>-<end> commands (default: California).
PHONE_FARM_TIMEZONE=America/Los_Angeles

# Optional: outgoing mail for account approval and recovery messages.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
