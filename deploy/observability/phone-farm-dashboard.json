{
  "annotations": { "list": [] },
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "title": "Hub scrape status",
      "type": "stat",
      "targets": [{ "expr": "up{job=\"phone-farm\"}", "legendFormat": "hub" }],
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } } }] }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "Request rate",
      "type": "timeseries",
      "targets": [{ "expr": "phone_farm:http_requests:rate5m", "legendFormat": "requests/s" }],
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 0 }
    },
    {
      "id": 3,
      "title": "Server error ratio",
      "type": "timeseries",
      "targets": [{ "expr": "phone_farm:http_server_errors:ratio5m", "legendFormat": "5xx ratio" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 0 }
    },
    {
      "id": 4,
      "title": "Average response duration",
      "type": "timeseries",
      "targets": [{ "expr": "phone_farm:http_request_duration:average5m", "legendFormat": "seconds" }],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    },
    {
      "id": 5,
      "title": "Process uptime",
      "type": "timeseries",
      "targets": [{ "expr": "phone_farm_process_uptime_seconds", "legendFormat": "uptime" }],
