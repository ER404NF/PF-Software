      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }
    },
    {
      "id": 6,
      "title": "Device control state",
      "type": "timeseries",
      "targets": [{ "expr": "phone_farm_devices", "legendFormat": "{{state}}" }],
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 }
    },
    {
      "id": 7,
      "title": "Queue state",
      "type": "timeseries",
      "targets": [{ "expr": "phone_farm_queue_tasks", "legendFormat": "{{state}}" }],
