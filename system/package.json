{
  "name": "phone-farm-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dual-mode human and AI VA control relay with mock and WebDriverAgent device adapters.",
  "scripts": {
    "start": "node server/src/index.js",
    "test": "node server/scripts/run-tests.js",
    "soak": "node server/scripts/soak-test.js",
    "demo": "node server/scripts/demo.js",
    "bench": "node server/bench/run.js",
    "backup:files": "node server/scripts/file-backup.js create",
    "restore:files": "node server/scripts/file-backup.js restore",
    "backup:postgres": "node server/scripts/postgres-backup.js create",
    "restore:postgres": "node server/scripts/postgres-backup.js restore",
    "backup:set": "node server/scripts/backup-set.js create",
    "restore:set": "node server/scripts/backup-set.js restore",
    "verify:backup-set": "node server/scripts/backup-set.js verify",
    "agent": "node server/src/agentMain.js",
    "migrate": "node-pg-migrate --migrations-dir server/migrations"
  },
  "dependencies": {
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "multer": "^2.4.0",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "ws": "^8.18.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
